# optional: only needed if anonymous requests get rate-limited or the reel needs login.
# grab the "sessionid" cookie from a logged-in instagram tab (devtools > application > cookies).
# use a throwaway account, not your main.
IG_SESSIONID=

# or mount a netscape cookies.txt and point at it
# IG_COOKIES_FILE=/downloads/cookies.txt

# override if instagram rotates graphql doc_ids
# REELGRAB_POLARIS_DOC_ID=27130156389949648
# REELGRAB_WEBINFO_DOC_ID=27128499623469141
